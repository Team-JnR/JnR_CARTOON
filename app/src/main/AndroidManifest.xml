<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS (Pleos Connect) 앱 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: 조회(Get) 권한만 사용, 제어 권한은 쓰지 않는다 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- TurnSignal, Light -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- Wiper, Window -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- Gear -->

    <!-- 사용자가 '소리 켜기'를 켠 동안 백그라운드에서도 신호 감지·재생 (부팅 자동 시작은 하지 않음:
         Pleos '미사용 앱 BG→CCH 전환 가이드' — 사용자 동작 없이 FGS를 시작·유지하지 않는다) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CartoonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CARTOON"
        tools:targetApi="34">

        <!-- 주행 규제(CarUxRestrictions) 조회. 없는 기기에서는 기어 기준 잠금만 쓴다 -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 화면은 상태 표시만 하고 주행 중 조작이 필요 없다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".service.CartoonService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the user has turned sounds on, plays short sound effects in response to vehicle signal changes (turn signal, wiper, gear) when the driver uses other apps" />
        </service>
    </application>

</manifest>
